{
  "name": "ttotem-native",
  "version": "0.16.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web",
    "test:engine": "tsc -p tsconfig.engine-test.json && node --test tests/engine/*.test.cjs",
    "verify:static": "node scripts/release-audit.cjs",
    "verify": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run test:engine && npm run test:auth && npm run test:puzzle && npm run test:matching && npm run test:path && npm run test:sheets && npm run test:stages && npm run verify:static",
    "release:check": "node scripts/release-audit.cjs --release",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "test:auth": "node --test tests/auth/*.test.cjs",
    "test:puzzle": "node --test tests/puzzle/*.test.cjs",
    "test:matching": "node --test tests/matching/*.test.cjs",
    "test:path": "node --test tests/path/*.test.cjs",
    "test:sheets": "node --test tests/sheets/*.test.cjs",
    "test:stages": "node --test tests/stages/*.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@quidone/react-native-wheel-picker": "^1.7.1",
    "@tanstack/react-query": "^5.90.0",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "jalaali-js": "2.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-carousel": "^5.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.17.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
