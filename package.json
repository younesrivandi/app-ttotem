{
  "name": "ttotem-native",
  "version": "0.16.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web",
    "test:engine": "tsc -p tsconfig.engine-test.json && node --test tests/engine/*.test.cjs",
    "verify:static": "node scripts/release-audit.cjs",
    "verify": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run test:engine && npm run test:auth && npm run test:puzzle && npm run verify:static",
    "release:check": "node scripts/release-audit.cjs --release",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "test:auth": "node --test tests/auth/*.test.cjs",
    "test:puzzle": "node --test tests/puzzle/*.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.0",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-file-system": "~19.0.17",
    "expo-haptics": "~15.0.7",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.0",
    "expo-video": "~3.0.16",
    "jalaali-js": "2.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.1.0",
    "@quidone/react-native-wheel-picker": "^1.7.1",
    "react-native-reanimated-carousel": "^5.1.1",
    "expo-navigation-bar": "~5.0.10"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "expo-doctor": "^1.17.0",
    "babel-preset-expo": "~54.0.0"
  }
}
