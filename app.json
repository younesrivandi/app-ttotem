{
  "expo": {
    "name": "TTOTEM",
    "slug": "ttotem",
    "scheme": "ttotem",
    "version": "0.16.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/branding/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/branding/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "ir.ttotem.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "TTOTEM برای ضبط پاسخ صوتی بازی به میکروفون نیاز دارد.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F6F8F6",
      "translucent": true
    },
    "extra": {
      "eas": {
        "projectId": "172f432c-5ef8-4494-a0f5-d9d48ec4c77d"
      }
    }
  }
}
