{
  "expo": {
    "name": "TTOTEM",
    "slug": "ttotem",
    "scheme": "ttotem",
    "version": "0.16.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/image/logo.png",
        "backgroundColor": "#F6F8F6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/image/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "TTOTEM برای ضبط پاسخ صوتی بازی به میکروفون نیاز دارد.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidNavigationBar": {
      "enforceContrast": true
    },
    "icon": "./assets/image/logo.png",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F6F8F6",
      "translucent": true
    }
  }
}
