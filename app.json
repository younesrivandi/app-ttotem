{
  "expo": {
    "name": "TTOTEM",
    "slug": "ttotem",
    "scheme": "ttotem",
    "version": "0.16.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "TTOTEM برای ضبط پاسخ صوتی بازی به میکروفون نیاز دارد.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    }
  }
}
